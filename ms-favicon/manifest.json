{
  "manifest_version": 3,
  "name": "MS Favicon Changer",
  "version": "1.0.0",
  "description": "Changes favicons on Azure Portal and Azure DevOps to reflect the current page context",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.portal.azure.com/*",
        "https://portal.azure.com/*"
      ],
      "js": ["content-scripts/azure-portal.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ],
      "js": ["content-scripts/ado.js"],
      "run_at": "document_idle"
    }
  ]
}
