{
  "manifest_version": 3,
  "name": "Tab Lock",
  "version": "1.0.0",
  "description": "Lock a tab so closing it immediately re-opens the same URL in the same position",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Tab Lock"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Toggle tab lock"
    }
  }
}
